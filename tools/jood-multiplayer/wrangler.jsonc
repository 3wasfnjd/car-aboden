{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jood-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects work on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://3wasfnjd.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
